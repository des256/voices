# Copy to .env next to compose.yaml on the server. Never commit .env.
VOICES_USERNAME=coach
VOICES_PASSWORD=choose-a-long-password
# Session signing key. Generate with: openssl rand -hex 32
# If omitted, a random key is used and everyone is signed out whenever the container restarts.
VOICES_SECRET=

# Optional tuning (defaults shown)
# VOICES_WHISPER_BEAM=5          # 1 is ~2x faster, slightly less accurate
# VOICES_MAX_MINUTES=60          # reject longer recordings
# VOICES_MAX_UPLOAD_MB=300
# VOICES_THREADS=2               # CPU threads for the models (defaults to the CPU count, max 8)
# VOICES_EMOTION_CATEGORICAL=true  # set false to skip the neutral/happy/angry/sad model (faster)
# VOICES_SESSION_HOURS=168
